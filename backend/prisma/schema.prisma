generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  username             String            @unique
  passwordHash         String?
  role                 Role              @default(USER)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  googleId             String?           @unique
  emailVerified        Boolean           @default(false)
  emailVerifyToken     String?
  emailVerifyExpires   DateTime?         @db.Timestamptz(6)
  passwordResetToken   String?
  passwordResetExpires DateTime?         @db.Timestamptz(6)
  avatar               String?
  achievements         Achievement[]
  chatMessages         ChatMessage[]
  sessions             PracticeSession[]
  profile              UserProfile?
  hostedClassrooms     Classroom[]

  @@map("users")
}

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  nativeLanguage  String   @default("en")
  targetLanguages String[]
  totalSessions   Int      @default(0)
  totalMinutes    Int      @default(0)
  avgAccuracy     Float    @default(0.0)
  streak          Int      @default(0)
  lastActiveAt    DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model PracticeSession {
  id             String   @id @default(uuid())
  userId         String
  language       String
  duration       Int
  accuracy       Float
  wordsAttempted Int
  wordsCorrect   Int
  transcript     String?
  feedback       String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("practice_sessions")
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  description String
  earnedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("achievements")
}

model ChatMessage {
  id        String      @id @default(uuid())
  userId    String
  roomId    String
  content   String
  type      MessageType @default(TEXT)
  createdAt DateTime    @default(now())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Language {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  flag   String
  active Boolean @default(true)

  @@map("languages")
}

model Classroom {
  id        String    @id @default(uuid())
  code      String    @unique
  title     String
  language  String    @default("en")
  hostId    String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  endedAt   DateTime?
  scheduledAt    DateTime?
  keywords       String[]  @default([])
  customGestures Json?
  summary        Json?
  summaryAt      DateTime?
  host      User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  captions  Caption[]
  members   ClassroomMember[]

  @@index([hostId])
  @@map("classrooms")
}

model Caption {
  id          String        @id @default(uuid())
  classroomId String
  speakerId   String?
  speakerName String
  source      CaptionSource @default(SPEECH)
  text        String
  createdAt   DateTime      @default(now())
  originalText String?
  editedAt     DateTime?
  editedById   String?
  classroom   Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId, createdAt])
  @@map("captions")
}

// Attendance + per-class role (CAPTIONER can correct captions). The host is Classroom.hostId.
model ClassroomMember {
  id            String    @id @default(uuid())
  classroomId   String
  userId        String
  username      String
  role          String    @default("STUDENT")
  joins         Int       @default(0)
  totalSeconds  Int       @default(0)
  firstJoinedAt DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@map("classroom_members")
}

enum CaptionSource {
  SPEECH
  SIGN
  TEXT
}

enum Role {
  USER
  TEACHER
  ADMIN
  MODERATOR
}

enum MessageType {
  TEXT
  AUDIO
  SYSTEM
}
