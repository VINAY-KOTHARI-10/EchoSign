generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String            @id @default(uuid())
  email                String            @unique
  username             String            @unique
  passwordHash         String?
  role                 Role              @default(USER)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  googleId             String?           @unique
  emailVerified        Boolean           @default(false)
  emailVerifyToken     String?
  emailVerifyExpires   DateTime?         @db.Timestamptz(6)
  passwordResetToken   String?
  passwordResetExpires DateTime?         @db.Timestamptz(6)
  avatar               String?
  achievements         Achievement[]
  chatMessages         ChatMessage[]
  chatReactions        ChatReaction[]
  chatRoomReads        ChatRoomRead[]
  sessions             PracticeSession[]
  profile              UserProfile?
  hostedClassrooms     Classroom[]

  @@map("users")
}

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  nativeLanguage  String   @default("en")
  targetLanguages String[]
  totalSessions   Int      @default(0)
  totalMinutes    Int      @default(0)
  avgAccuracy     Float    @default(0.0)
  streak          Int      @default(0)
  lastActiveAt    DateTime @default(now())
  bio             String?
  // Teachers and admins: the languages they teach. Used to show the right teachers in each language's community room.
  teachingLanguages String[] @default([])
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model PracticeSession {
  id             String   @id @default(uuid())
  userId         String
  language       String
  duration       Int
  accuracy       Float
  wordsAttempted Int
  wordsCorrect   Int
  transcript     String?
  feedback       String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("practice_sessions")
}

model Achievement {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  description String
  earnedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("achievements")
}

model ChatMessage {
  id        String         @id @default(uuid())
  userId    String
  roomId    String
  content   String
  type      MessageType    @default(TEXT)
  createdAt DateTime       @default(now())
  // Community chat: a reply quotes an earlier message; deleting marks the row (the text is blanked) instead of removing it,
  // so replies to it still show "This message was deleted".
  replyToId String?
  deletedAt DateTime?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  replyTo   ChatMessage?   @relation("ChatReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[]  @relation("ChatReplies")
  reactions ChatReaction[]
  attachment ChatAttachment?

  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// A file sent with a chat message (an image or a PDF, at most 2 MB). The bytes live in the database, so there is no extra storage
// service to set up; removing the message removes the file.
model ChatAttachment {
  id        String      @id @default(uuid())
  messageId String      @unique
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("chat_attachments")
}

// One reaction per person per message (changing it replaces it; choosing it again removes it).
model ChatReaction {
  id        String      @id @default(uuid())
  messageId String
  userId    String
  kind      String
  createdAt DateTime    @default(now())
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("chat_reactions")
}

// Where each person has read up to in each room, for the unread counts.
model ChatRoomRead {
  userId     String
  roomId     String
  lastReadAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roomId])
  @@map("chat_room_reads")
}

model Language {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  flag   String
  active Boolean @default(true)

  @@map("languages")
}

model Classroom {
  id        String    @id @default(uuid())
  code      String    @unique
  title     String
  language  String    @default("en")
  hostId    String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  endedAt   DateTime?
  scheduledAt    DateTime?
  keywords       String[]  @default([])
  customGestures Json?
  summary        Json?
  summaryAt      DateTime?
  host      User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  captions  Caption[]
  members   ClassroomMember[]

  @@index([hostId])
  @@index([active, createdAt])
  @@map("classrooms")
}

model Caption {
  id          String        @id @default(uuid())
  classroomId String
  speakerId   String?
  speakerName String
  source      CaptionSource @default(SPEECH)
  text        String
  createdAt   DateTime      @default(now())
  originalText String?
  editedAt     DateTime?
  editedById   String?
  clientId     String?       // idempotency key from the sender, so a retried send never stores a second caption
  classroom   Classroom     @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([classroomId, createdAt])
  @@unique([classroomId, clientId])
  @@index([classroomId, speakerId])
  @@map("captions")
}

// Attendance + per-class role (CAPTIONER can correct captions). The host is Classroom.hostId.
model ClassroomMember {
  id            String    @id @default(uuid())
  classroomId   String
  userId        String
  username      String
  role          String    @default("STUDENT")
  joins         Int       @default(0)
  totalSeconds  Int       @default(0)
  firstJoinedAt DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  lastLeftAt    DateTime?
  reconnects    Int       @default(0)
  classroom     Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@index([userId])
  @@map("classroom_members")
}

enum CaptionSource {
  SPEECH
  SIGN
  TEXT
}

enum Role {
  USER
  TEACHER
  ADMIN
  MODERATOR
}

enum MessageType {
  TEXT
  AUDIO
  SYSTEM
}

// Who changed what (role changes, class ended, user deleted...). Append-only, viewed by admins.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorName  String?
  action     String
  targetType String?
  targetId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}
