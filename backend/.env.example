# Copy to backend/.env for local use. In production set these as environment variables on your host
# (never commit real values). See DEPLOYMENT.md.

# ─── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# ─── Databases ───────────────────────────────────────────────
# MongoDB Atlas: login sessions, one-time login codes, pronunciation attempt records and the practice activity feed.
# (Classroom captions, chat, attendance and practice sessions are NOT here: they live in PostgreSQL.)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/echosign
# Optional: set if mongodb+srv lookups fail with ECONNREFUSED (comma-separated DNS servers)
# DNS_SERVERS=8.8.8.8,1.1.1.1
# Neon PostgreSQL: accounts, classes, captions, chat, attendance and practice sessions (the source of truth).
# Pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# ─── Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))") ──
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
SESSION_SECRET=change-me-three
# Optional lifetimes
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d

# ─── AI (Groq) ───────────────────────────────────────────────
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# ─── Google sign-in ──────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local:      http://localhost:5000/api/v1/auth/google/callback
# Production: https://YOUR-DOMAIN/api/v1/auth/google/callback  (also add it in Google Cloud Console)
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ─── Public address of the site (no trailing slash) ──────────
FRONTEND_URL=http://localhost:5000
# More websites served by this same backend (comma-separated, no trailing slash), for example a second frontend.
# Sign-in redirects and email links go back to the website the person came from, if it is listed here or in FRONTEND_URL.
# FRONTEND_URLS=https://second-site.vercel.app

# ─── Email (Brevo) — sends the login verification code ───────
BREVO_API_KEY=
EMAIL_FROM=

# ─── CORS ────────────────────────────────────────────────────
# Only needed if the frontend is hosted on a different origin than the backend (comma-separated).
# The default setup serves both from one origin, so leave this empty.
# ALLOWED_ORIGINS=https://app.example.com

# ─── Rate limiting ───────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=300

# ─── Proxy hops (Vercel proxying to Render = 2; Render alone = 1) ──
# TRUST_PROXY=1

# ─── Sign Meet (video meetings) ──────────────────────────────────────────────
# WEBRTC_ICE_SERVERS=[{"urls":"stun:stun.example.org:3478"}]   # only needed for meetings across the internet; empty keeps everything on the local network
# HTTPS_KEY_FILE=backend/certs/lan-key.pem                    # set both (npm run lan does it for you) to serve https on the local network
# HTTPS_CERT_FILE=backend/certs/lan-cert.pem

# ─── Data retention (see docs/DATABASE.md; nothing is deleted automatically) ──
# AUDIT_RETENTION_DAYS=365
# CLASS_RETENTION_DAYS=          # leave empty to keep ended classes and transcripts forever
# UNVERIFIED_ACCOUNT_DAYS=7      # sign-ups that never entered the emailed code are removed by `maintenance retention --apply` after this many days
