# Copy to .env.local for local development, and set the same names in the Vercel project (Settings, Environment Variables).
# Never commit .env.local.

# The EchoSign backend (Render). Server-only. No trailing slash. Locally: http://localhost:5000
BACKEND_URL=http://localhost:5000

# This site's public address (used for the sitemap, share previews and canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# A NEW Neon project, separate from the main EchoSign database. Pooled address for the app, direct address for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# Secret for the on-demand cache refresh address (POST /api/revalidate). Any long random string.
REVALIDATE_SECRET=change-me
