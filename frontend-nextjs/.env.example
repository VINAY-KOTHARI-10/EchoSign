# Copy to .env.local for local development. Never commit .env.local.
#
# ON VERCEL you only need TWO variables: BACKEND_URL and DATABASE_URL. Everything else below is optional.

# REQUIRED. The EchoSign backend (Render). Server-only. No trailing slash. Locally: http://localhost:5000
BACKEND_URL=http://localhost:5000

# REQUIRED. A NEW Neon project, separate from the main EchoSign database. The POOLED address (host contains "-pooler").
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require

# ONLY FOR MIGRATIONS (run from your computer: npx prisma migrate deploy). Not needed on Vercel or to run the site.
DIRECT_URL=postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# OPTIONAL. The site's public address. On Vercel it is found automatically; set it only for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://your-site.vercel.app

# OPTIONAL. Secret for the on-demand cache refresh address (POST /api/revalidate). Without it that address is switched off.
# REVALIDATE_SECRET=change-me
