# Only needed when the API is on a different origin than the site (it normally is not).
# In production the app calls /api/v1 on its own origin.
# VITE_API_URL=https://api.example.com/api/v1

# Vercel + Render split deploy: the browser talks to /api on the Vercel address (frontend/vercel.json proxies it
# to Render, so login cookies stay first-party). Only live captions connect straight to Render:
# VITE_SOCKET_URL=https://YOUR-API.onrender.com
