{
  "name": "EchoSign: live captions for every classroom",
  "short_name": "EchoSign",
  "description": "Real-time speech and sign captions, lecture notes and transcripts for deaf and hard-of-hearing students.",
  "id": "/",
  "start_url": "/classroom",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
